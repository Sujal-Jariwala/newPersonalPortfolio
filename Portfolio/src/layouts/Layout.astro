---
import { getImage } from "astro:assets";
import Footer from "../components/Footer";
import Navbar from "../components/Navbar";
import "../styles/index.css";
import webIcon from "../assets/IMG_9606-modified.png";
const {
  title = "Sujal Jariwala | Portfolio",
  description = "Personal portfolio of Sujal Jariwala — a developer showcasing projects, skills, and experience in web development and software engineering.",
} = Astro.props;

const optimizedIcon = await getImage({
  src: webIcon,
  quality: 50,
  format: "webp",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={optimizedIcon.src} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body ontouchstart="">
    <Navbar client:load />
    <hr class="lg:mb-10 border-black/10" />
    <slot />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
